# HTTP server port (set automatically by most cloud platforms)
PORT=3000

# Optional canonical public HTTPS URL for QR codes & join links behind a reverse proxy
# PUBLIC_URL=https://pocketparty.example.com

# Optional Google Cast Custom Web Receiver App ID
# CAST_APP_ID=

# Standalone local LAN HTTPS mode (leave false in cloud hosting where TLS terminates at the proxy)
HTTPS=false
HTTPS_PORT=3443
